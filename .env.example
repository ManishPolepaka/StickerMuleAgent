# Netlify serverless: prefer connection_limit=1 in the Netlify UI env var
DATABASE_URL="postgresql://postgres.ejmmhsreprgxzwpazwws:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&connect_timeout=10"
DIRECT_URL="postgresql://postgres.ejmmhsreprgxzwpazwws:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

